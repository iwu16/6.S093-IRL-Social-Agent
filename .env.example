MASTODON_INSTANCE=https://mastodon.social

# Replicate API (for image generation with --with-image flag)
# Get your token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram (for HITL approval with --hitl flag)
# 1. Create bot: Message @BotFather on Telegram, send /newbot
# 2. Get chat ID: Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=0000000000
